# ==============================================================================
# Furni Gebeya (ፈርኒ ገበያ) - Complete Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL Database & Realtime Chat)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AfroMessage API Configuration (Ethiopian SMS, OTP & Trial Reminders)
# Docs: https://afromessage.com/developer
# ------------------------------------------------------------------------------
AFROMESSAGE_API_TOKEN=your-afromessage-api-token-here
AFROMESSAGE_SENDER_NAME=FurniGebeya
AFROMESSAGE_IDENTIFIER_ID=

# ------------------------------------------------------------------------------
# OTP Security & Cryptography
# ------------------------------------------------------------------------------
OTP_SECRET=furni-gebeya-secure-random-otp-hmac-secret-key-32chars
ADMIN_PHONE=+2519XXXXXXXX

# ------------------------------------------------------------------------------
# Vercel Cron Security Secret (Trial reminder SMS jobs)
# ------------------------------------------------------------------------------
CRON_SECRET=furni_gebeya_cron_secret_2026

# ------------------------------------------------------------------------------
# Cloudinary Configuration (Avatars, Cover Photos & Furniture Photos)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=furni_avatars

# ------------------------------------------------------------------------------
# Chapa Payment Gateway (Ready for pluggable production activation)
# ------------------------------------------------------------------------------
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-chapa-public-key
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
